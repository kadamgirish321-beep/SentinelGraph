# ============================================================
# AttackGraphX API Gateway — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets.
# ============================================================

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# JWT Authentication
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_STRING_HERE
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Analysis Service (upstream, operated by Person 1/2)
ANALYSIS_SERVICE_URL=http://localhost:9000
ANALYSIS_TIMEOUT=10
ANALYSIS_RETRIES=3

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_TTL=300

# CORS — Frontend origin (Vite default)
FRONTEND_ORIGIN=http://localhost:5173
