# ─────────────────────────────────────────────────────────────────────────────
# AttackGraphX Recon Service — Environment Configuration Template
#
# Copy this file to .env and adjust values for your environment.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ── Redis ──────────────────────────────────────────────────────────────────────
# Use 'redis' as hostname when running inside docker-compose
REDIS_URL=redis://redis:6379/0
REDIS_TOPIC=scan_results
REDIS_CONNECT_TIMEOUT=5
REDIS_MAX_RETRIES=3

# ── Network / Scan Scope ───────────────────────────────────────────────────────
# Only scan targets within RANGE_CIDR are permitted.
RANGE_NETWORK=attackgraphx-net
RANGE_CIDR=172.20.0.0/24

# ── Nmap ───────────────────────────────────────────────────────────────────────
# -sV : service version detection
# -T4 : aggressive timing (faster, acceptable for lab use)
NMAP_SCAN_FLAGS=-sV -T4
NMAP_TIMEOUT_SECONDS=300

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Interval between scheduled scans (minutes). Set to 0 to disable.
SCAN_INTERVAL_MINUTES=30
SCAN_DEFAULT_TARGET=172.20.0.0/24
